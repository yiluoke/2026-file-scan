# 本番用の例。/opt/file-scan/.env.search にコピーし、仮値を置き換えます。
# file-search.service が EnvironmentFile で読み込みます。

# 検索API専用DBロール。DB名・ホスト・ポートは取込用 .env と揃えます。
# SEARCH_DB_PASSWORD のURL予約文字はパーセントエンコードします。
FILE_SCAN_DATABASE_URL=postgresql+psycopg://file_scan_search:SEARCH_DB_PASSWORD@127.0.0.1:5432/file_scan

# 呼出元が Authorization: Bearer で送る接続キー。通常・テストモード共通です。
FILE_SCAN_SEARCH_API_KEY=SEARCH_CONNECTION_KEY

# 通常モードで質問Embeddingを生成するためのキーです。
OPENAI_API_KEY=sk-placeholder-replace-me

# トークナイザー辞書を事前配置する本番キャッシュのパスです。
TIKTOKEN_CACHE_DIR=/var/cache/file-scan/tiktoken
