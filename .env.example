# .envへコピーして開発用に設定します。実際の.envはGit管理対象外です。
# Docker Composeは.envを読みますが、Python CLIは自動では読みません。
POSTGRES_PASSWORD=change-this-local-password
# 下記PASSWORDを上の値に合わせ、シェルの環境変数としてexportしてください。
FILE_SCAN_DATABASE_URL=postgresql+psycopg://file_scan:PASSWORD@127.0.0.1:5432/file_scan
# pytestは専用DBを使います。PASSWORDは上と同じ値にしてください。
FILE_SCAN_TEST_DATABASE_URL=postgresql+psycopg://file_scan:PASSWORD@127.0.0.1:5432/file_scan_test

# 実キーへ置換し、Embeddingを実行する文書取込設定のembedding.enabledをtrueにします。
OPENAI_API_KEY=sk-placeholder-replace-me

# C++／Qt仕様書を生成する場合に設定してexportします。
# CPP_SCAN_LLM_MODEL=社内APIのモデルID
# CPP_SCAN_LLM_API_KEY=社内APIの認証キー
# CPP_SCAN_LLM_BASE_URL=https://llm.example.internal/v1

# 検索APIの接続キー。通常・テストモード共通で使用し、OpenAIキーとは分けます。
FILE_SCAN_SEARCH_API_KEY=replace-with-your-search-api-key
